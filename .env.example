# Copy to .env and fill in. This file is never committed.

# --- Database (PostgreSQL, local) ---
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Web interface ---
# The one password that protects the interface, even for a single user.
DINDON_PASSWORD=change-me-too
DINDON_PORT=8000

# --- Local AI (Ollama) ---
# On a Mac, run Ollama natively (it can use the GPU, Docker cannot): see README.md.
# On a Linux server, use the "ollama" profile of docker-compose.yml and set http://ollama:11434.
OLLAMA_URL=http://host.docker.internal:11434

# --- Discord (used from phase 1, by the collector) ---
# A bot token is recommended. Automating a personal account is against Discord's terms of service
# and can get it closed: see the warning in README.md.
# DISCORD_TOKEN=
